[
    {
        "type": "visible",
        "package": "com.sunilpaulmathew.translator",
        "target": {
            "text": "You haven't imported any 'string' translation file yet. Go to the 'Settings' menu to import one from 'sdcard'!"
        }
    },
    {
        "type": "click",
        "package": "com.sunilpaulmathew.translator",
        "target": {
            "resource-id": "com.sunilpaulmathew.translator:id/settings_menu"
        }
    },
    {
        "type": "click",
        "package": "com.sunilpaulmathew.translator",
        "target": {
            "text": "Import 'string'"
        }
    },
    {
        "type": "click",
        "package": "com.sunilpaulmathew.translator",
        "target": {
            "resource-id": "android:id/text1",
            "text": "Device Storage"
        }
    },
    {
        "type": "click",
        "package": "com.google.android.documentsui",
        "target": {
            "content-desc": "Show roots"
        }
    },
    {
        "type": "click",
        "package": "com.google.android.documentsui",
        "target": {
            "resource-id": "android:id/title",
            "text": "Downloads"
        }
    },
    {
        "type": "click",
        "package": "com.google.android.documentsui",
        "target": {
            "resource-id": "android:id/title",
            "text": "string.xml"
        }
    },
    {
        "type": "click",
        "package": "com.sunilpaulmathew.translator",
        "target": {
            "resource-id": "android:id/button1",
            "text": "IMPORT"
        }
    },
    {
        "type": "click",
        "package": "com.sunilpaulmathew.translator",
        "target": {
            "resource-id": "com.sunilpaulmathew.translator:id/description",
            "text": "Hello World!"
        }
    },
    {
        "type": "click",
        "package": "com.sunilpaulmathew.translator",
        "target": {
            "resource-id": "com.sunilpaulmathew.translator:id/text",
            "text": "Hello World!"
        }
    },
    {
        "type": "click",
        "package": "com.sunilpaulmathew.translator",
        "target": {
            "resource-id": "com.google.android.inputmethod.latin:id/key_pos_del"
        }
    },
    {
        "type": "click",
        "package": "com.sunilpaulmathew.translator",
        "target": {
            "resource-id": "android:id/button1",
            "text": "YES"
        }
    },
    {
        "type": "visible",
        "package": "com.sunilpaulmathew.translator",
        "target": {
            "resource-id": "com.sunilpaulmathew.translator:id/description",
            "text": "Hello World"
        }
    },
    {
        "type": "click",
        "package": "com.sunilpaulmathew.translator",
        "target": {
            "resource-id": "com.sunilpaulmathew.translator:id/fab"
        }
    },
    {
        "type": "click",
        "package": "com.sunilpaulmathew.translator",
        "target": {
            "resource-id": "android:id/button1",
            "text": "SAVE"
        }
    }
]